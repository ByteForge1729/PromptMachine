{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ultimate-prompt-engine interview state",
  "description": "Machine state for resuming and amending an interview. Written after every Phase 3 review.",
  "type": "object",
  "required": ["skill", "project", "archetype", "round", "lenses", "decisions", "contradictions", "open_cascades", "coverage"],
  "properties": {
    "skill": {"const": "ultimate-prompt-engine"},
    "schema_version": {"type": "integer", "default": 2},
    "project": {"type": "string"},
    "archetype": {"type": "string"},
    "phase": {"enum": ["intake", "brainstorm", "interview", "emitted", "amending"]},
    "round": {"type": "integer", "minimum": 0},
    "stopped_early": {"type": "boolean", "description": "True when the user said 'enough' with must-ask or should-ask questions still open"},
    "lenses": {"type": "array", "items": {"type": "string"}},
    "brainstorm": {
      "type": "object",
      "description": "Synthesis of the optional brainstorm. Not decisions.",
      "properties": {
        "kept": {"type": "array", "items": {"type": "string"}},
        "pushed_away": {"type": "array", "items": {"type": "string"}},
        "open_threads": {"type": "array", "items": {"type": "string"}},
        "idea": {"type": "string"}
      }
    },
    "delights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": {"type": "string", "description": "DL1, DL2, ..."},
          "name": {"type": "string"},
          "reason": {"type": "string"},
          "cost": {"type": "string"},
          "status": {"enum": ["accepted", "edited", "rejected"]}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "q", "answer", "status"],
        "properties": {
          "id": {"type": "string", "description": "Stable id, e.g. R3.size or A12"},
          "q": {"type": "string"},
          "answer": {"type": "string"},
          "status": {"enum": ["open", "answered", "auto-decided", "deferred", "needs_clarification", "contradicted", "superseded"]},
          "round": {"type": "integer"},
          "source": {"type": "string", "description": "'user freeform', 'option', or a URL for research-backed decisions"},
          "why": {"type": "string"},
          "reversibility": {"enum": ["cheap", "costly", "one-way"]},
          "closes": {"type": "array", "items": {"type": "string"}},
          "superseded_by": {"type": "string"},
          "found_at_emit": {"type": "boolean"}
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["between", "issue"],
        "properties": {
          "between": {"type": "array", "items": {"type": "string"}},
          "issue": {"type": "string"},
          "resolved_by": {"type": ["string", "null"]}
        }
      }
    },
    "open_cascades": {"type": "array", "items": {"type": "string"}},
    "research": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "label"],
        "properties": {
          "finding": {"type": "string"},
          "label": {"enum": ["documented", "widely reported", "my judgment"]},
          "source": {"type": "string"}
        }
      }
    },
    "references": {
      "type": "array",
      "description": "User-supplied taste references and what was extracted from each",
      "items": {"type": "object", "properties": {"ref": {"type": "string"}, "took": {"type": "string"}, "palette": {"type": "array", "items": {"type": "string"}}}}
    },
    "coverage": {
      "type": "object",
      "description": "Per lens: how many must-ask and should-ask questions apply, and how many of each are answered or assumed",
      "additionalProperties": {"type": "object", "required": ["must", "done"], "properties": {"must": {"type": "integer"}, "done": {"type": "integer"}, "should": {"type": "integer"}, "should_done": {"type": "integer"}}}
    }
  }
}
